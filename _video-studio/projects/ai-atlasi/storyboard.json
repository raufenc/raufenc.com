    "32 araç": "ai-atlasi/data.js → RAUF_AI_ATLAS.tools.length = 32 (sayfadaki #heroStats sayacı da 32)",
    "8 kategori": "ai-atlasi/data.js → new Set(tools.map(t=>t.category)).size = 8; sayfadaki kategori ızgarası 8 kart",
    "31 ücretsiz plan": "ai-atlasi/data.js → tools.filter(t=>t.free_plan).length = 31 (yalnız Midjourney ücretsiz plansız); #heroStats",
    "6 set": "ai-atlasi/data.js → featuredStacks.length = 6, her biri stack[] 3 araç (#setler bölümü)",
    "7 modül": "ai-atlasi/data.js → workshopTracks.length = 7 (#atolye zaman çizelgesi)",
    "Ses & Müzik 4 araç": "ai-atlasi/data.js → category 'Ses & Müzik': ElevenLabs, Descript, Suno, Udio; tıklayınca '4 araç gösteriliyor'",
    "Kalite/Kolaylık/Erişim/Atölye puanları, değer puanı": "ai-atlasi/script.js → scoreBars() ve scoreRing(value_score); Canva 92",
    "artıları, eksileri, fiyatı ve kayıt linki": "ai-atlasi/script.js → toolCard(): advantages/disadvantages, price_note, signup_url 'Kayıt Ol'",
    "Excel olarak indir": "ai-atlasi/index.html → raufenc_yapay_zeka_araclari_kitabi.xlsx download bağlantısı",
    "Kayıt gerekmez": "ai-atlasi statik sayfa; giriş/hesap akışı yok",
    "accent": "ai-atlasi/style.css → --accent #8b5cf6; accent2 hero-glow-2 rgba(6,182,212) / --cat-color-1 #06b6d4",
    "Ders, sunum, kısa video setleri": "ai-atlasi/data.js → featuredStacks başlıkları: Ders çalışma, Sunum ve anlatı, Kısa video, Web/app prototipi, Kod öğrenme, …"
  }
