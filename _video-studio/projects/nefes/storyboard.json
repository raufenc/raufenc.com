  "_kaynak": {
    "Her evre kendi renginde": "index.html :root --c-inhale #45d0c1, --c-hold #a78bfa, --c-exhale #f0a35e; setPhaseVisuals() --pc'yi değiştirir (d-al/d-tut/d-ver çekimleri)",
    "Küre büyür / dolu kalır / küçülür": "index.html orbScale(): inhale 1→1.42 easeInOutSine, hold 1.42 (+hafif titreşim), exhale 1.42→1",
    "Türkçe sesli komutlar": "index.html speak(): SpeechSynthesisUtterance lang 'tr-TR', PHASES.speak 'Nefes al'/'Tut'/'Nefes ver'; ayarlar: 'Sesli yönlendirme — Türkçe sesli komutlar'",
    "Faz çanları ve ortam tınısı": "index.html chime()/phaseSound() (faz geçişinde çan), startPad() (ortam tınısı, Web Audio); ayar anahtarları 'Ortam müziği', 'Nefes ve çan sesleri'",
    "3'ten ∞'a döngü": "index.html #cycle-chips: 3, 4 (varsayılan), 6, 8, ∞",
    "Döngü, süre ve toplam seans": "index.html finish(): #d-cycles, #d-time, #d-total; temiz 4 döngülük seans → '4 DÖNGÜ | 1:19 SÜRE | 1 TOPLAM SEANS' (3 sn hazırlık + 4×19 sn = 79 sn)",
    "İlerlemen bu cihazda saklanır": "index.html commitStats() saveJSON('rauf-nefes-stats') → localStorage {sessions:1,cycles:4,seconds:79}; renderStatsChip(): '🌿 1 seans · 4 döngü · 1 dk' (d-sonra/m-sonra çekimi; gerçek çip zoom ile öne çıkarılır)",
    "Ücretsiz / Kayıt gerekmez": "index.html JSON-LD offers price 0; giriş/oturum yok, tercihler localStorage",
    "Sakinleştirici sesler, zihnin durulsun": "projeler.json desc ve index.html bilgi bölümü ('zihin durulur')",
    "4 saniye al, 7 tut, 8 ver (kanca)": "nefes/index.html PHASES: inhale dur 4, hold dur 7, exhale dur 8 (etiketler 'Nefes al', 'Tut', 'Ver'); ekrandaki geri sayım çekimlerde doğrulandı",
    "19 sn tek döngü": "index.html PHASES: 4 + 7 + 8 = 19 sn; çekimde ölçülen evre aralıkları 4.01 / 7.02 / 8.02 sn",
    "1:19 — 4 döngülük seans": "index.html PREP dur 3 + 4 döngü (prefs.cycles varsayılan 4) × 19 sn = 79 sn; finish() fmtDuration(Math.round(...)) → d-bitti ve m-bitti çekimlerinde '4 DÖNGÜ | 1:19 SÜRE | 1 TOPLAM SEANS'",
    "5 döngü seçeneği": "index.html #cycle-chips: 3, 4 (varsayılan), 6, 8, ∞ (5 çip; d-ayarlar/m-ayarlar çekimleri)"
