{"no":107,"id":"maun","ad":"Mâûn Sûresi","inisYeri":"Mekke","ayetSayisi":7,"sayfa":602,"ayetler":[{"no":1,"ar":"أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ","sayfa":602,"di":"Dini yalan sayanı gördün mü","dv":"Dini yalanlayanı gördün mü","el":"Dini yalanlayanı gördün mü"},{"no":2,"ar":"فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ","sayfa":602,"di":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur","dv":"İşte o, yetimi itip kakar","el":"İşte o, öksüzü iter, kakar"},{"no":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ","sayfa":602,"di":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur","dv":"Yoksulu doyurmaya teşvik etmez","el":"Yoksulu doyurmaya önayak olmaz"},{"no":4,"ar":"فَوَيْلٌ لِلْمُصَلِّينَ","sayfa":602,"di":"Vay o namaz kılanların haline ki","dv":"Yazıklar olsun o namaz kılanlara ki","el":"Vay haline o namaz kılanların ki"},{"no":5,"ar":"الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ","sayfa":602,"di":"Onlar kıldıkları namazdan gafildirler","dv":"Onlar namazlarını ciddiye almazlar","el":"Kıldıkları namazın değerine aldırış etmezler"},{"no":6,"ar":"الَّذِينَ هُمْ يُرَاءُونَ","sayfa":602,"di":"Onlar gösteriş yaparlar","dv":"Onlar gösteriş yapanlardır","el":"Gösteriş yaparlar onlar"},{"no":7,"ar":"وَيَمْنَعُونَ الْمَاعُونَ","sayfa":602,"di":"Onlar basit şeyleri dahi vermezler","dv":"Ve hayra da mani olurlar","el":"Ve yardımlığı sakınırlar (zekatı vermezler)"}]}