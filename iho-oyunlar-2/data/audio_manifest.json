      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p009",
      "text_ar": "هَل تُريدُ شيئًا آخَر؟",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p010",
