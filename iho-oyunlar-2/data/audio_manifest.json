      "path": null
    },
    {
      "audio_key": "u2_pattern_p011",
      "text_ar": "أَهْلًا وَسَهْلًا، أَيُّ خِدْمَةٍ؟",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p012",
      "text_ar": "عِنْدي {item1}، {item2}، و{item3}",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p013",
      "text_ar": "{item1} أَرْخَصُ مِنْ {item2}",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p014",
      "text_ar": "{item1} أَغْلى مِنْ {item2}",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p015",
      "text_ar": "{item1} أَكْبَرُ/أَصْغَرُ مِنْ {item2}",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p016",
      "text_ar": "{item1} أَخَفُّ/أَثْقَلُ مِنْ {item2}",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p017",
      "text_ar": "مِنْ أَيْنَ اشْتَرَيْتَ؟",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p018",
      "text_ar": "ماذا اشْتَرَيْتَ؟",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p019",
      "text_ar": "إِلى أَيْنَ تَذْهَبُ لِلتَّسَوُّقِ؟",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p020",
      "text_ar": "أُعِدُّ قائِمَةَ التَّسَوُّقِ",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p021",
      "text_ar": "شُكْرًا، مَعَ السَّلامَةِ",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_pattern_p022",
      "text_ar": "مَنْ غَشَّنا فَلَيْسَ مِنّا",
      "type": "pattern",
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_01",
      "text_ar": "أَنا بِحاجَةٍ إِلى بَعْضِ الأَشْياءِ مِنَ البَقّالَةِ.",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 1,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_02",
      "text_ar": "ماذا تُريدينَ يا أُمّي؟",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 2,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_03",
      "text_ar": "أَطْلُبُ مِنْكَ كيلو سُكَّرٍ، وعُلْبَةَ مِلْحٍ، وعُلْبَتَيْنِ مِنَ الشّايِ.",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 3,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_04",
      "text_ar": "أُريدُ خُبْزًا طازَجًا أَيْضًا.",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 4,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_05",
      "text_ar": "هَل تُريدينَ شيئًا آخَر؟",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 5,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d001_06",
      "text_ar": "حَسَنًا، سَأَذْهَبُ الآنَ.",
      "type": "dialogue_line",
      "dialogue_id": "d001",
      "line_no": 6,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_01",
      "text_ar": "أَهْلًا وَسَهْلًا، أَيُّ خِدْمَةٍ؟ ماذا تُريدينَ؟",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 1,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_02",
      "text_ar": "أَهْلًا بِكَ، أَنا بِحاجَةٍ إِلى خَضْراواتٍ طازَجَةٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 2,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_03",
      "text_ar": "عِنْدي طَماطِمُ، خِيارٌ، جَزَرٌ، باذِنْجانٌ، بَطاطا، بَصَلٌ، فُلْفُلٌ، وفاصوليا.",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 3,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_04",
      "text_ar": "جَميلٌ جِدًّا! وهَل عِنْدَكَ فَواكِهُ أَيْضًا؟",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 4,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_05",
      "text_ar": "نَعَم، عِنْدي تُفّاحٌ، بُرْتُقالٌ، مَوْزٌ، عِنَبٌ، كَرَزٌ، ومِشْمِشٌ.",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 5,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d002_06",
      "text_ar": "حَسَنًا، أُريدُ كيلوغرامًا واحِدًا مِنْ كُلِّ نَوْعٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d002",
      "line_no": 6,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_01",
      "text_ar": "أَهْلًا وَسَهْلًا! أَيُّ خِدْمَةٍ يا سَيِّدي؟",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 1,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_02",
      "text_ar": "أَهْلًا بِكَ، أُريدُ أَنْ أَشْتَري بَعْضَ الخُضَرِ، بِكَم الفاصوليا؟",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 2,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_03",
      "text_ar": "بِتِسْعِ ليراتٍ، هِيَ طازَجَةٌ جِدًّا.",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 3,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_04",
      "text_ar": "لَكِنَّها غالِيَةٌ، وأَغْلى مِنَ البَطاطا. أُريدُ كيلوغرامًا واحِدًا فَقَطْ.",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 4,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_05",
      "text_ar": "العِنَبُ رَخيصٌ اليَوْمَ، وهُوَ أَرْخَصُ مِنَ التُّفّاحِ. هَل تُريدُ مِنْهُ؟",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 5,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d003_06",
      "text_ar": "لا، شُكْرًا جَزيلًا. هذا كافٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d003",
      "line_no": 6,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_01",
      "text_ar": "أَهْلًا وَسَهْلًا! أَيُّ خِدْمَةٍ؟",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 1,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_02",
      "text_ar": "أَهْلًا بِكَ، أَنا بِحاجَةٍ إِلى كيلو زَيْتونٍ وعُلْبَةِ مَكَرونَةٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 2,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_03",
      "text_ar": "تَفَضَّل، هَل تُريدُ شيئًا آخَر؟",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 3,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_04",
      "text_ar": "نَعَم، أُريدُ أَنْ أَشْتَري مَوْزًا. بِكَم المَوْزُ؟",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 4,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_05",
      "text_ar": "المَوْزُ بِعَشْرِ ليراتٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 5,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_06",
      "text_ar": "لَكِنَّهُ أَغْلى مِنَ المِشْمِشِ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 6,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_07",
      "text_ar": "نَعَم، المِشْمِشُ أَرْخَصُ مِنَ المَوْزِ اليَوْمَ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 7,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_08",
      "text_ar": "حَسَنًا، أُريدُ ثَلاثَةَ كيلوغراماتٍ مِنَ المِشْمِشِ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 8,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_09",
      "text_ar": "تَفَضَّل.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 9,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d004_10",
      "text_ar": "شُكْرًا، مَعَ السَّلامَةِ.",
      "type": "dialogue_line",
      "dialogue_id": "d004",
      "line_no": 10,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_01",
      "text_ar": "أَهْلًا فاروق! أَيُّ خِدْمَةٍ؟",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 1,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_02",
      "text_ar": "أَهْلًا بِكَ، أَنا بِحاجَةٍ إِلى حَليبٍ.",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 2,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_03",
      "text_ar": "حَسَنًا، كَم تُريدُ مِنَ الحَليبِ؟",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 3,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_04",
      "text_ar": "أُريدُ عُلْبَةً واحِدَةً.",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 4,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_05",
      "text_ar": "حَسَنًا، هَل تُريدُ شيئًا آخَر؟",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 5,
      "path": null
    },
    {
      "audio_key": "u2_dialogue_d005_06",
      "text_ar": "لا، شُكْرًا لَكَ.",
      "type": "dialogue_line",
      "dialogue_id": "d005",
      "line_no": 6,
      "path": null
    }
  ]
}