{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://www.gstatic.com https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://firestore.googleapis.com wss://*.firebaseio.com https://api.openai.com https://*.basemaps.cartocdn.com; frame-ancestors 'self'; base-uri 'self' /tarih/; form-action 'self' mailto:" }
      ]
    },
    {
      "source": "/tarih/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/tarih/(.*\\.js|.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lab.raufenc.com" }],
      "destination": "https://raufenc.com/:path*",
      "permanent": true
    },
    {
      "source": "/5sinif",
      "destination": "/5sinif/",
      "permanent": false
    },
    {
      "source": "/hakkinda",
      "destination": "/#hakkinda",
      "permanent": true
    },
    {
      "source": "/hakkinda/",
      "destination": "/#hakkinda",
      "permanent": true
    },
    {
      "source": "/projeler",
      "destination": "/#projeler",
      "permanent": true
    },
    {
      "source": "/projeler/",
      "destination": "/#projeler",
      "permanent": true
    },
    {
      "source": "/osmanlica-lugat",
      "destination": "/osmanlica/",
      "permanent": true
    },
    {
      "source": "/osmanlica-lugat/",
      "destination": "/osmanlica/",
      "permanent": true
    },
    {
      "source": "/ingilizce-app",
      "destination": "/ingilizce-kelime/",
      "permanent": true
    },
    {
      "source": "/ingilizce-app/",
      "destination": "/ingilizce-kelime/",
      "permanent": true
    },
    {
      "source": "/ingilizc-lugat",
      "destination": "/ingilizce-kelime/",
      "permanent": true
    },
    {
      "source": "/ingilizc-lugat/",
      "destination": "/ingilizce-kelime/",
      "permanent": true
    },
    {
      "source": "/davetmektubu",
      "destination": "https://davetmektubu.com/",
      "permanent": true
    },
    {
      "source": "/davetmektubu/",
      "destination": "https://davetmektubu.com/",
      "permanent": true
    },
    {
      "source": "/davetmektubu/:path*",
      "destination": "https://davetmektubu.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/iyilikakademi",
      "destination": "/iyilikakademi/index.html"
    },
    {
      "source": "/iyilikakademi/",
      "destination": "/iyilikakademi/index.html"
    },
    {
      "source": "/iyilikakademi/:path((?!assets/).*)",
      "destination": "/iyilikakademi/index.html"
    },
    {
      "source": "/tarih",
      "destination": "/tarih/index.html"
    },
    {
      "source": "/tarih/",
      "destination": "/tarih/index.html"
    },
    {
      "source": "/tarih/:path((?!data/|style\\.css|.*\\.js|assets/).*)",
      "destination": "/tarih/index.html"
    }
  ]
}
