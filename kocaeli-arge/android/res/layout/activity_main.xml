<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/navy">
    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/offline" android:visibility="gone" android:orientation="vertical" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/navy" android:padding="32dp">
        <ImageView android:src="@drawable/splash_logo" android:layout_width="96dp" android:layout_height="96dp" android:contentDescription="@string/app_name" />
        <TextView android:id="@+id/offlineText" android:text="@string/offline" android:textColor="@color/white" android:textSize="16sp" android:gravity="center" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/retry" android:text="@string/retry" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <FrameLayout android:id="@+id/fullscreen" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" />
</FrameLayout>
